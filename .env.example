# ── Required ─────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/smartlink?schema=public"

# Only needed when the provider pools connections (Neon, Supabase, PgBouncer).
# DATABASE_URL should be the POOLED endpoint, used by the app at runtime.
# DIRECT_DATABASE_URL is the UNPOOLED endpoint, used only by migrations — a
# transaction-mode pooler cannot hold the session-level locks a migration needs.
#
# Neon example:
#   DATABASE_URL="postgresql://u:p@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/smartlink?sslmode=verify-full"
#   DIRECT_DATABASE_URL="postgresql://u:p@ep-xxx.ap-southeast-1.aws.neon.tech/smartlink?sslmode=verify-full"
DIRECT_DATABASE_URL=""

# Salt for IP and visitor-token hashing. No raw IP is ever persisted, only a
# salted hash — if this leaks, those hashes become reversible by brute force
# over the small IP space. Required in production; the app refuses to start
# without it.
IP_HASH_SALT="CHANGE_ME"

# ── Destinations and links ───────────────────────────────────

# Hosts a destination URL may point at. Comma separated, no scheme. Checked
# when a destination is registered, again when it is approved, and again on
# every redirect (TRD §5). Leave unset to use the built-in default:
# betindia.bet, www.betindia.bet, wa.me, api.whatsapp.com
DESTINATION_HOST_ALLOWLIST=""

# Public base of the redirect domain, used to build the short URL shown in the
# admin UI. No trailing slash.
SMART_LINK_BASE_URL="https://go.betindia.bet"

# Query parameter carrying the click ID to our own website. First-party only —
# it is never appended to a WhatsApp destination.
CLICK_QUERY_PARAM="bi_click"

# ── Display ──────────────────────────────────────────────────

# Storage is UTC everywhere; this is display only.
DISPLAY_TIMEZONE="Asia/Kolkata"

# ── Webhooks ─────────────────────────────────────────────────

# Public base URL of this app, used to show the webhook address in the admin
# UI. On localhost, set this to your tunnel address (ngrok, Cloudflare Tunnel)
# so the URL shown is one Interakt can actually reach.
PUBLIC_APP_URL=""

# Shared secret for the Interakt capture endpoint. Leave empty and the endpoint
# accepts unauthenticated events, recording them as such — visible on the
# Integrations screen rather than silently assumed safe.
#
# Interakt's real signature scheme is unknown until a payload is captured. Once
# the captured headers show how they authenticate, replace this with proper
# signature verification (TRD §6).
INTERAKT_WEBHOOK_SECRET=""
INTERAKT_WEBHOOK_SECRET_HEADER="x-webhook-secret"

# ── Operational ──────────────────────────────────────────────

DB_POOL_MAX="10"

# Password given to every seeded account by `npm run db:seed`. Local
# development only — the seed refuses to run with NODE_ENV=production.
SEED_PASSWORD="ChangeMe-Local-2026"
